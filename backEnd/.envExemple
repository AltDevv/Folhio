#Configuração do Banco com o Folhio, e com o Docker
POSTGRES_DB=folio
POSTGRES_URL=jdbc:postgresql://localhost:5432/folio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

#Configuração do StudioWeb
FOLHIO_APP_API_KEY=SUA_SENHA

#Essa opção dita se a verificação do ClanAV é necessária
FOLHIO_REQUIRE_SECURE_CONFIG=false

#Detalhamento dos logs de erro
FOLHIO_LOGS_DETAILED_ERRORS=false

#Aqui você pode por sua URL
FOLHIO_API_BASE_URL=https://SUA_URL_EXEMPLO

#Google
GOOGLE_WEB_CLIENT_ID=SEU_WEB_CLIENT_ID_EXEMPLO
FOLHIO_AUTH_ACCESS_TOKEN_SECRET=SEU_AUTH_ACCESS_TOKEN_EXEMPLO
FOLHIO_AUTH_PASSWORD_PEPPER=SEU_AUTH_PASSWORD_PEPPER_EXEMPLO
ROTA=http://localhost:8080/admin
ROTA2=http://localhost:8080/studio

#Email
FOLHIO_MAIL_ENABLED=true
FOLHIO_MAIL_FROM=EMAIL_EXEMPLO_@gmail.com
FOLHIO_SMTP_HOST=smtp.gmail.com
FOLHIO_SMTP_PORT=587
FOLHIO_SMTP_USERNAME=EMAIL_EXEMPLO_@gmail.com
FOLHIO_SMTP_PASSWORD=SUA_SENHA_EXEMPLO
FOLHIO_SMTP_AUTH=true
FOLHIO_SMTP_STARTTLS=true
FOLHIO_WEBSOCKET_ALLOWED_ORIGINS=http://_EXEMPLO_WEBSOCKET
